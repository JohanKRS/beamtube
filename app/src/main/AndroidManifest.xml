<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tocar com a tela desligada (celular e tablet): o serviço de mídia em primeiro plano, com o
         processador e o Wi-Fi acordados enquanto o vídeo toca (player.PlaybackService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- O toque na notificação traz de volta a tela do player, mesmo numa tarefa de outro app
         (um link aberto pelo WhatsApp). -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- Um APK só: roda com ou sem tela de toque, com ou sem leanback. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- O youtubeapi declara usb.host como obrigatório; não é. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false"
        tools:replace="android:required" />

    <application
        android:name=".App"
        android:banner="@drawable/tv_banner_night"
        android:icon="@mipmap/ic_launcher_night"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_night"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">
        <!--
          Android 16 ignora o sentido fixo da tela em tablets para apps no SDK 36. O player precisa
          dele (deitar para vídeo horizontal, o botão de girar): esta é a saída que o Android dá,
          e ela vale até o app passar para o SDK 37.
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <!-- Link de playlist vindo de fora: abre a página da playlist (com o botão de inscrição). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="www.youtube.com" />
                <data android:host="youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:path="/playlist" />
            </intent-filter>
        </activity>

        <!-- Ícone do app (Settings > App icon): um activity-alias por cor, e só um fica ligado
             (ytslim.data.AppIcons). O azul-noite é o padrão. Nunca renomear nem tirar um alias:
             quem estivesse com ele escolhido ficaria sem o app no launcher. -->
        <activity-alias
            android:name=".LauncherNight"
            android:banner="@drawable/tv_banner_night"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_night"
            android:roundIcon="@mipmap/ic_launcher_night"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherBlack"
            android:banner="@drawable/tv_banner_black"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_black"
            android:roundIcon="@mipmap/ic_launcher_black"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherTeal"
            android:banner="@drawable/tv_banner_teal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_teal"
            android:roundIcon="@mipmap/ic_launcher_teal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherPlum"
            android:banner="@drawable/tv_banner_plum"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_plum"
            android:roundIcon="@mipmap/ic_launcher_plum"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherMustard"
            android:banner="@drawable/tv_banner_mustard"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mustard"
            android:roundIcon="@mipmap/ic_launcher_mustard"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherVivid"
            android:banner="@drawable/tv_banner_vivid"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_vivid"
            android:roundIcon="@mipmap/ic_launcher_vivid"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherRed"
            android:banner="@drawable/tv_banner_red"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_red"
            android:roundIcon="@mipmap/ic_launcher_red"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Também abre links do YouTube vindos de fora (WhatsApp, navegador, Compartilhar).
             Esses vídeos tocam sem ir para o histórico. Shorts ficam de fora.
             No celular e no tablet, sair do app com o vídeo tocando abre o mini player flutuante. -->
        <activity
            android:name=".player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.App.Player"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="www.youtube.com" />
                <data android:host="youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/live/" />
                <data android:pathPrefix="/embed/" />
                <data android:pathPrefix="/v/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="youtu.be" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Tocar com a tela desligada (celular e tablet): a sessão de mídia do player, com a
             notificação e o controle da tela de bloqueio. Só o app fala com ele. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Painel de dormir do player: desligar a TV quando os vídeos acabam ("When done: Turn off").
             Só o sistema se liga a ele (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".player.ScreenOffService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_off_service" />
        </service>
    </application>
</manifest>
