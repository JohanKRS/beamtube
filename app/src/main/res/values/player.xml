<?xml version="1.0" encoding="utf-8"?>
<!--
  Controles do player (opção A do desenho de 2026-11-02, escolhida pelo Johan): o título e as
  ações numa pílula de vidro em cima; embaixo, uma ilha de vidro com tocar, tempo, barra e os
  botões do vídeo. Poucos botões, com foco bem visível para o D-pad da TV.
-->
<resources>
    <color name="player_icon">#F3EFE4</color>
    <color name="player_text_secondary">#C9C6BD</color>
    <color name="player_on_light">#18191B</color>
    <!-- O ponto do botão LIVE no ponto ao vivo: o vermelho do YouTube. -->
    <color name="player_live">#FF0000</color>

    <!--
      Margens da tela, o título e os tamanhos dos botões. Compactos desde 2026-11-03 (pedido do
      Johan: mais espaço para o vídeo); antes 32/20/18 dp de margem, título de 17 sp em duas linhas,
      ilha de 56 dp e botões de 40 dp. Na TV (values-television) ficam um pouco maiores, longe da
      borda e fáceis de ver com o foco.
    -->
    <dimen name="player_edge">20dp</dimen>
    <dimen name="player_edge_top">12dp</dimen>
    <dimen name="player_title_size">15sp</dimen>
    <integer name="player_title_lines">1</integer>
    <dimen name="player_row_height">48dp</dimen>
    <dimen name="player_play_size">38dp</dimen>
    <dimen name="player_button_size">36dp</dimen>
    <dimen name="player_button_padding">9dp</dimen>
    <dimen name="player_pill_button_size">32dp</dimen>
    <dimen name="player_pill_button_padding">7dp</dimen>
    <dimen name="player_subscribe_height">28dp</dimen>
    <!--
      A barra de baixo vai de borda a borda (2026-11-03); o conteúdo dela fica a esta distância
      das laterais e da borda de baixo.
    -->
    <dimen name="player_bar_side">14dp</dimen>
    <dimen name="player_bar_bottom">4dp</dimen>
    <dimen name="player_actions_gap">12dp</dimen>
    <!--
      A margem da legenda até a borda de baixo, só para não encostar (pedido do Johan, 2026-11-03).
      Com os controles abertos, a legenda fica a essa mesma distância acima da barra (CaptionLift).
    -->
    <dimen name="player_captions_bottom">8dp</dimen>
    <!-- A barra de tempo: a ChapterTimeBar usa as mesmas medidas para pôr a fresta dos capítulos. -->
    <dimen name="player_bar_height">3dp</dimen>
    <dimen name="player_scrubber_dragged">18dp</dimen>
    <dimen name="player_chapter_gap">2dp</dimen>
    <!-- O preview ao arrastar a barra: a miniatura (16:9) dentro de um cartão de vidro. -->
    <dimen name="player_preview_width">168dp</dimen>
    <dimen name="player_preview_height">90dp</dimen>

    <!-- Botão de ícone (like, legenda, lua…). -->
    <style name="PlayerButton">
        <item name="android:layout_width">@dimen/player_button_size</item>
        <item name="android:layout_height">@dimen/player_button_size</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:padding">@dimen/player_button_padding</item>
        <item name="android:background">@drawable/player_button_bg</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- Botão de ícone dentro da pílula de cima. -->
    <style name="PlayerPillButton" parent="PlayerButton">
        <item name="android:layout_width">@dimen/player_pill_button_size</item>
        <item name="android:layout_height">@dimen/player_pill_button_size</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:padding">@dimen/player_pill_button_padding</item>
    </style>

    <!-- Painel (resolução, dormir): um cartão à direita, logo acima da ilha. -->
    <style name="PlayerPanel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:layout_marginStart">@dimen/player_edge</item>
        <item name="android:layout_marginEnd">@dimen/player_edge</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/player_panel_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="PlayerPanelTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/player_icon</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
    </style>

    <!-- Uma linha do painel: o nome em cima, as opções num trilho embaixo. -->
    <style name="PlayerPanelGroup">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="PlayerPanelLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#A7A8AD</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
    </style>

    <!-- Os trilhos de um painel ficam da mesma largura (sameWidth, no PlayerActivity). -->
    <style name="PlayerSegments">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">3dp</item>
        <item name="android:background">@drawable/player_segments_bg</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Uma opção do painel (criada no código: os layout_* ficam lá). -->
    <style name="PlayerChip">
        <item name="android:minWidth">52dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/player_segment_bg</item>
        <item name="android:textColor">@color/player_segment_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="PlayerTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textColor">@color/player_icon</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
