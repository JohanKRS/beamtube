<?xml version="1.0" encoding="utf-8"?>
<!--
  A cor de destaque no player (Views), a mesma de ytslim.ui.Accent: o PlayerActivity aplica o
  estilo da cor escolhida no tema antes de montar a tela, e os drawables e cores do player leem
  ?attr/doorglowAccent (cheia) e ?attr/doorglowAccentSoft (clara).
-->
<resources>
    <attr name="doorglowAccent" format="color" />
    <attr name="doorglowAccentSoft" format="color" />

    <style name="PlayerAccent" />

    <style name="PlayerAccent.Amber">
        <item name="doorglowAccent">#FFFFC861</item>
        <item name="doorglowAccentSoft">#FFFFE3A3</item>
    </style>

    <style name="PlayerAccent.Red">
        <item name="doorglowAccent">#FFFF6B5F</item>
        <item name="doorglowAccentSoft">#FFFFB4AC</item>
    </style>

    <style name="PlayerAccent.Pink">
        <item name="doorglowAccent">#FFFF8CC6</item>
        <item name="doorglowAccentSoft">#FFFFC7E3</item>
    </style>

    <style name="PlayerAccent.Purple">
        <item name="doorglowAccent">#FFC3A2FF</item>
        <item name="doorglowAccentSoft">#FFE2D3FF</item>
    </style>

    <style name="PlayerAccent.Blue">
        <item name="doorglowAccent">#FF7CB6FF</item>
        <item name="doorglowAccentSoft">#FFC2DCFF</item>
    </style>

    <style name="PlayerAccent.Teal">
        <item name="doorglowAccent">#FF5FD3C3</item>
        <item name="doorglowAccentSoft">#FFB3EDE5</item>
    </style>

    <style name="PlayerAccent.Green">
        <item name="doorglowAccent">#FF97D97E</item>
        <item name="doorglowAccentSoft">#FFCDEDC0</item>
    </style>
</resources>
