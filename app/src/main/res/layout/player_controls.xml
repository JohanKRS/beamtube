<?xml version="1.0" encoding="utf-8"?>
<!--
  Controles do player (opção A, escolhida pelo Johan em 2026-11-02).
  Em cima: título, canal (abre a página dele) e, à direita, uma pílula de vidro com like, dislike,
  Save e Subscribe (na TV elas descem para a barra de baixo, PlayerIsland). Embaixo: uma barra de
  vidro de borda a borda, sem cantos (pedido do Johan, 2026-11-03), com tocar/pausar, tempo,
  barra, legenda, resolução, girar a tela (só no celular e no tablet) e o modo dormir (lua); no
  celular em pé e na TV ela vira duas linhas (PlayerIsland). Os tamanhos ficam em
  values/player.xml (compactos desde 2026-11-03, um pouco maiores na TV). Os painéis da resolução
  e do modo dormir abrem acima da barra, à direita; as opções deles o PlayerActivity cria.
  Os capítulos (2026-11-03): uma fresta na barra onde cada um começa (ChapterTimeBar) e o nome do
  atual logo acima da ilha. Ao arrastar a barra, um cartão acima dela mostra a miniatura daquele
  ponto, o nome do capítulo e o tempo (PlayerActivity.showPreview).
  Os ids exo_* são os que o PlayerControlView do Media3 procura; os player_* o app liga.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <View
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="bottom"
        android:background="@drawable/player_scrim_bottom" />

    <LinearLayout
        android:id="@+id/player_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_scrim_top"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="@dimen/player_edge"
        android:paddingTop="@dimen/player_edge_top"
        android:paddingEnd="@dimen/player_edge"
        android:paddingBottom="32dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Sem cortar o que passa da coluna: o contorno do nome do canal sai 8 dp para a esquerda. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_semibold"
                android:maxLines="@integer/player_title_lines"
                android:textColor="@color/player_icon"
                android:textSize="@dimen/player_title_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- O nome do canal: um toque (ou OK na TV) abre a página dele. O texto fica alinhado
                     com o título e o contorno do foco sai para a esquerda (achado do Johan na TV,
                     2026-11-04: antes ele aparecia cortado). -->
                <TextView
                    android:id="@+id/player_channel"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="-8dp"
                    android:background="@drawable/player_button_bg"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:fontFamily="@font/figtree_semibold"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/player_icon"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/player_detail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/figtree_medium"
                    android:maxLines="1"
                    android:textColor="@color/player_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/player_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/player_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/player_like"
                style="@style/PlayerPillButton"
                android:contentDescription="@string/player_like"
                android:src="@drawable/ic_thumb_up" />

            <ImageButton
                android:id="@+id/player_dislike"
                style="@style/PlayerPillButton"
                android:contentDescription="@string/player_dislike"
                android:src="@drawable/ic_thumb_down" />

            <ImageButton
                android:id="@+id/player_save"
                style="@style/PlayerPillButton"
                android:contentDescription="@string/player_save"
                android:src="@drawable/ic_bookmark_border"
                android:visibility="gone" />

            <TextView
                android:id="@+id/player_subscribe"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/player_subscribe_height"
                android:layout_marginStart="4dp"
                android:background="@drawable/player_subscribe_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/figtree_semibold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/player_subscribe"
                android:textColor="@color/player_subscribe_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/player_quality_panel"
            style="@style/PlayerPanel"
            android:visibility="gone">

            <TextView
                style="@style/PlayerPanelTitle"
                android:text="@string/player_quality" />

            <LinearLayout
                android:id="@+id/player_quality_options"
                style="@style/PlayerSegments"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/player_sleep_panel"
            style="@style/PlayerPanel"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bedtime"
                    android:tint="@color/player_accent" />

                <TextView
                    style="@style/PlayerPanelTitle"
                    android:text="@string/player_sleep" />
            </LinearLayout>

            <LinearLayout style="@style/PlayerPanelGroup">

                <TextView
                    style="@style/PlayerPanelLabel"
                    android:text="@string/player_brightness" />

                <LinearLayout
                    android:id="@+id/player_sleep_brightness"
                    style="@style/PlayerSegments" />
            </LinearLayout>

            <LinearLayout style="@style/PlayerPanelGroup">

                <TextView
                    style="@style/PlayerPanelLabel"
                    android:text="@string/player_then_play" />

                <LinearLayout
                    android:id="@+id/player_sleep_queue"
                    style="@style/PlayerSegments" />
            </LinearLayout>

            <LinearLayout style="@style/PlayerPanelGroup">

                <TextView
                    style="@style/PlayerPanelLabel"
                    android:text="@string/player_when_done" />

                <LinearLayout
                    android:id="@+id/player_sleep_end"
                    style="@style/PlayerSegments" />
            </LinearLayout>
        </LinearLayout>

        <!-- O capítulo em que o vídeo está (só em vídeos com capítulos). -->
        <TextView
            android:id="@+id/player_chapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/player_bar_side"
            android:layout_marginEnd="@dimen/player_bar_side"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_semibold"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowRadius="8"
            android:textColor="@color/player_icon"
            android:textSize="13sp"
            android:visibility="gone" />

        <!--
          A barra de baixo, de borda a borda. Numa tela estreita (o celular em pé) e na TV o
          PlayerIsland passa o tempo e a barra para a linha de cima (player_bar_row).
        -->
        <LinearLayout
            android:id="@+id/player_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/player_island_bg"
            android:orientation="vertical"
            android:paddingStart="@dimen/player_bar_side"
            android:paddingEnd="@dimen/player_bar_side"
            android:paddingBottom="@dimen/player_bar_bottom">

            <LinearLayout
                android:id="@+id/player_bar_row"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/player_button_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/player_row_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@id/exo_play_pause"
                    android:layout_width="@dimen/player_play_size"
                    android:layout_height="@dimen/player_play_size"
                    android:background="@drawable/player_play_bg"
                    android:contentDescription="@string/player_play_pause"
                    android:focusable="true"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/player_on_light" />

                <TextView
                    android:id="@id/exo_position"
                    style="@style/PlayerTime"
                    android:layout_marginStart="6dp" />

                <!--
                  As marcas claras na barra são onde começam os trechos que o público pula: avançar
                  dentro de um deles, ou logo antes, vai para o fim dele (PlayerActivity.jumpAhead).
                -->
                <ytslim.player.ChapterTimeBar
                    android:id="@id/exo_progress"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    app:ad_marker_color="@color/player_icon"
                    app:ad_marker_width="3dp"
                    app:bar_height="@dimen/player_bar_height"
                    app:buffered_color="#61F3EFE4"
                    app:played_color="?attr/doorglowAccent"
                    app:scrubber_color="?attr/doorglowAccent"
                    app:scrubber_dragged_size="@dimen/player_scrubber_dragged"
                    app:scrubber_enabled_size="12dp"
                    app:touch_target_height="32dp"
                    app:unplayed_color="#38F3EFE4" />

                <TextView
                    android:id="@id/exo_duration"
                    style="@style/PlayerTime"
                    android:textColor="@color/player_text_secondary" />

                <!--
                  Ao vivo, no lugar do tempo e da duração (que ficam parados numa live): o ponto é
                  vermelho no ponto ao vivo e cinza atrás dele, e tocar volta para o ao vivo. O
                  PlayerIsland põe o botão na linha dos botões, onde o foco da TV chega.
                -->
                <TextView
                    android:id="@+id/player_live"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/player_button_bg"
                    android:clickable="true"
                    android:contentDescription="@string/player_go_live"
                    android:drawableStart="@drawable/player_live_dot"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/player_live"
                    android:textColor="@color/player_icon"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/player_island_divider"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="#24F3EFE4" />

                <!-- Só com a barra na linha de cima: empurra os botões para a direita. -->
                <View
                    android:id="@+id/player_island_spacer"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/player_captions"
                    style="@style/PlayerButton"
                    android:contentDescription="@string/player_captions"
                    android:src="@drawable/ic_captions"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/player_quality_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/player_quality_bg"
                    android:clickable="true"
                    android:contentDescription="@string/player_quality"
                    android:focusable="true"
                    android:fontFamily="@font/figtree_bold"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:minWidth="44dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:textColor="@color/player_icon"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Celular e tablet: deitar ou pôr em pé (o player já gira sozinho conforme o vídeo). -->
                <ImageButton
                    android:id="@+id/player_rotate"
                    style="@style/PlayerButton"
                    android:contentDescription="@string/player_rotate"
                    android:src="@drawable/ic_screen_rotation"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/player_sleep"
                    style="@style/PlayerButton"
                    android:contentDescription="@string/player_sleep"
                    android:src="@drawable/ic_bedtime" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      O preview ao arrastar a barra: a miniatura do ponto (o storyboard do YouTube), o capítulo e o
      tempo. O PlayerActivity põe o cartão acima da ilha, seguindo o círculo da barra.
    -->
    <LinearLayout
        android:id="@+id/player_preview"
        android:layout_width="@dimen/player_preview_width"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="@drawable/player_preview_bg"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/player_preview_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/player_preview_height"
            android:layout_marginBottom="3dp"
            android:background="@drawable/player_preview_frame_bg"
            android:importantForAccessibility="no"
            android:scaleType="matrix" />

        <TextView
            android:id="@+id/player_preview_chapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_semibold"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/player_icon"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/player_preview_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:fontFamily="@font/figtree_medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:textColor="@color/player_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
