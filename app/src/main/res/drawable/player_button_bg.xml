<?xml version="1.0" encoding="utf-8"?>
<!-- Botões de ícone do player: sem fundo; o foco (TV) e o toque acendem um círculo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#4DFFC861" />
            <stroke android:width="2dp" android:color="@color/launcher_night_glow" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#33F3EFE4" />
        </shape>
    </item>
    <!-- Ligado (legenda, modo dormir em uso). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#2EFFC861" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
