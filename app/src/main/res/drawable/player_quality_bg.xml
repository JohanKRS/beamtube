<?xml version="1.0" encoding="utf-8"?>
<!-- O botão de resolução: uma etiqueta com contorno ("2160p"). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="@color/player_accent_20" />
            <stroke android:width="2dp" android:color="@color/player_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#33F3EFE4" />
            <stroke android:width="1dp" android:color="#47F3EFE4" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <stroke android:width="1dp" android:color="#47F3EFE4" />
        </shape>
    </item>
</selector>
